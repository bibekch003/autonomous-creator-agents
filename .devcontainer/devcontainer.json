{
  "name": "Autonomous Creator Agents",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r backend/requirements.txt && cd backend && alembic upgrade head",
  "postStartCommand": "cd backend && nohup uvicorn app.main:app --host 0.0.0.0 --port 8000 >/tmp/aca-server.log 2>&1 </dev/null &",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Autonomous Creator Agents",
      "onAutoForward": "notify"
    }
  }
}