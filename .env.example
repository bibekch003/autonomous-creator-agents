# Copy this file to .env in the repository root and adjust as needed.
# Everything has a working default, so an empty .env still runs locally.

# --- app -------------------------------------------------------------------
ACA_ENVIRONMENT=development
ACA_DEBUG=true

# --- security --------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ACA_SECRET_KEY=
ACA_SESSION_TTL_HOURS=168
# Set to true when the app is served over HTTPS (recommended in production).
ACA_COOKIE_SECURE=false
ACA_COOKIE_SAMESITE=lax

# --- database --------------------------------------------------------------
# Empty = SQLite at storage/aca.db (fine for local development).
# PostgreSQL example:
# ACA_DATABASE_URL=postgresql+psycopg://aca:acapassword@localhost:5432/aca
ACA_DATABASE_URL=
ACA_SQL_ECHO=false

# --- storage ---------------------------------------------------------------
# Empty = ./storage in the repository root. In Docker this is /data.
ACA_STORAGE_ROOT=
ACA_MAX_UPLOAD_MB=500

# --- processing ------------------------------------------------------------
ACA_CLIP_MIN_SECONDS=3
ACA_CLIP_MAX_SECONDS=90
ACA_MAX_SEGMENTS=8
# Local speech-to-text. Requires: pip install faster-whisper
ACA_ENABLE_WHISPER=false
ACA_WHISPER_MODEL=base

# --- optional external AI (never required) ---------------------------------
# Any OpenAI-compatible endpoint. Without a key the deterministic template
# engine writes the copy and results are labelled "offline".
ACA_LLM_API_KEY=
ACA_LLM_BASE_URL=https://api.openai.com/v1
ACA_LLM_MODEL=gpt-4o-mini

# --- web -------------------------------------------------------------------
ACA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- frontend (Vite, development only) ------------------------------------
VITE_API_TARGET=http://127.0.0.1:8000
